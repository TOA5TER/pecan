# Copy to pecan.env (gitignored, never commit) and edit; see README.md "Config reference".

# Hostname assigned to the running container (docker run --hostname).
PECAN_HOSTNAME=pecan

# Host directory bind-mounted as the workspace inside the container.
PECAN_HOST_DIR=/path/to/projects
PECAN_WORKSPACE=/home/pecan/projects

# Docker named volume persisting pi's agent state, mounted at PECAN_HOME/.pi/agent.
PECAN_VOLUME_NAME=pecan-agent-state

# Base image and resulting image tag consumed by docker-bake.hcl.
PECAN_BASE_IMAGE=node:24-bookworm-slim
PECAN_IMAGE=pecan:latest

# Space-separated extra apt packages; quote multi-word values (e.g. "jq curl").
PECAN_EXTRA_PACKAGES=""

# Non-root username and home directory created in the image.
PECAN_USER=pecan
PECAN_HOME=/home/pecan

# Resource limits applied to the running container.
PECAN_MEMORY_LIMIT=4g
PECAN_CPU_LIMIT=2
